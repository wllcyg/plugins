{
  "name": "project-100-free",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "100款免费生产力插件计划 - Monorepo 代码库",
  "scripts": {
    "dev:template": "pnpm --filter @100free/ext-template dev",
    "build:template": "pnpm --filter @100free/ext-template build",
    "dev:table": "pnpm --filter @100free/ext-table-export dev",
    "build:table": "pnpm --filter @100free/ext-table-export build",
    "dev:shot": "pnpm --filter @100free/ext-screenshot dev",
    "build:shot": "pnpm --filter @100free/ext-screenshot build",
    "dev:copy": "pnpm --filter @100free/ext-allow-copy dev",
    "build:copy": "pnpm --filter @100free/ext-allow-copy build",
    "dev:css": "pnpm --filter @100free/ext-css-inspector dev",
    "build:css": "pnpm --filter @100free/ext-css-inspector build",
    "dev:sniffer": "pnpm --filter @100free/ext-image-sniffer dev",
    "build:sniffer": "pnpm --filter @100free/ext-image-sniffer build",
    "dev:video": "pnpm --filter @100free/ext-video-master dev",
    "build:video": "pnpm --filter @100free/ext-video-master build",
    "dev:qr": "pnpm --filter @100free/ext-qr-master dev",
    "build:qr": "pnpm --filter @100free/ext-qr-master build",
    "dev:redirect": "pnpm --filter @100free/ext-clean-redirect dev",
    "build:redirect": "pnpm --filter @100free/ext-clean-redirect build",
    "dev:highlighter": "pnpm --filter @100free/ext-highlighter dev",
    "build:highlighter": "pnpm --filter @100free/ext-highlighter build",
    "dev:recorder": "pnpm --filter @100free/ext-screen-studio dev",
    "build:recorder": "pnpm --filter @100free/ext-screen-studio build",
    "dev:portal": "pnpm --filter @100free/web-portal dev",
    "build:portal": "pnpm --filter @100free/web-portal build",
    "build:all": "pnpm -r run build",
    "zip:all": "pnpm --filter \"./apps/ext-*\" --filter \"!@100free/ext-template\" run zip",
    "compile:all": "pnpm -r --if-present compile",
    "type-check": "pnpm -r run type-check"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vue": "^3.5.13",
    "@types/node": "^22.10.7",
    "@types/chrome": "^0.0.304"
  },
  "packageManager": "pnpm@10.27.0"
}

